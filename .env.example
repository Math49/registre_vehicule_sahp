# Premier compte admin, créé au démarrage si aucun admin n'existe encore.
ADMIN_USERNAME=admin.vasquez
ADMIN_PASSWORD=change-moi-svp

# Fuseau horaire utilisé pour afficher les dates (JJ/MM/AAAA).
NEXT_PUBLIC_TIMEZONE=America/Toronto

# Emplacement de la base SQLite (par défaut : data/registre.db).
# DATABASE_PATH=./data/registre.db

# Cookie de session réservé au HTTPS (défaut en production). Mettre false si le site est servi en HTTP simple.
# COOKIE_SECURE=true
